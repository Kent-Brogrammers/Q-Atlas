{
  "name": "q-atlas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run check",
    "types:export": "../backend/.venv/bin/python ../backend/scripts/export_openapi.py > openapi.json",
    "types:generate": "npm run types:export && npm run generate --workspace @q-atlas/api-types",
    "types:check": "npm run types:export && npm run generate --workspace @q-atlas/api-types -- --check",
    "test:compiler": "node --experimental-strip-types tests/compiler-source.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^25.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.6"
  },
  "workspaces": [
    "tools/api-types"
  ]
}
