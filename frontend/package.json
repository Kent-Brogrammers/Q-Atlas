{
  "name": "q-atlas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "types:generate": "../backend/.venv/bin/python ../backend/scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/types/api.generated.ts --default-non-nullable false",
    "types:check": "npm run types:generate -- --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
